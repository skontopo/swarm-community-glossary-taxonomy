PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX schema: <http://schema.org/>

SELECT
    ?concept
    ?prefLabel
    ?altLabel
    ?candidate
    ?candidateLabel
    ?candidateDescription
    ?rank
WHERE {

    # Retrieve SWARM glossary concepts
    ?concept
        a skos:Concept ;
        skos:prefLabel ?prefLabel .

    OPTIONAL {
        ?concept skos:altLabel ?altLabel .
    }

    # Skip concepts already linked
    FILTER NOT EXISTS {
        ?concept skos:exactMatch ?existingMatch .
    }

    BIND(
        STR(?prefLabel)
        AS ?searchTerm
    )

    # Search Wikidata
    SERVICE <https://query.wikidata.org/sparql> {

        SERVICE wikibase:mwapi {

            bd:serviceParam
                wikibase:endpoint "www.wikidata.org" ;
                wikibase:api "EntitySearch" ;
                mwapi:search ?searchTerm ;
                mwapi:language "en" ;
                mwapi:type "item" ;
                mwapi:limit 3 .

            ?candidate
                wikibase:apiOutputItem mwapi:item .

            ?candidateLabel
                wikibase:apiOutput mwapi:label .

            ?rank
                wikibase:apiOrdinal true .
        }

        OPTIONAL {
            ?candidate
                schema:description
                    ?candidateDescription .

            FILTER (
                LANG(?candidateDescription) = "en"
            )
        }
    }
}
ORDER BY
    LCASE(STR(?prefLabel))
    ?rank